      "format": "date-time",
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "instrument_id": {
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "spread_bps": {
      "type": "number",
      "x-unit": "basis_points"
    },
    "spread_curve_id": {
      "type": "string"
    },
    "tenor_years": {

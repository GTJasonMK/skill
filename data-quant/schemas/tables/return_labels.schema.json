{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Execution-aligned forward return labels with explicit end time.",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "benchmark": {
      "type": [
        "string",
        "null"
      ]
    },
    "corporate_action_policy": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "decision_at": {
      "format": "date-time",
      "type": "string"
    },
    "execution_at": {
      "format": "date-time",
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "return_basis": {
      "type": "string"
    },
    "return_end": {
      "format": "date-time",
      "type": "string"
    },
    "return_start": {
      "format": "date-time",
      "type": "string"
    },
    "return_type": {
      "type": "string"
    },
    "return_value": {
      "type": "number",
      "x-unit": "decimal_return"
    }
  },
  "required": [
    "decision_at",
    "execution_at",
    "return_start",
    "return_end",
    "asset_id",
    "label",
    "return_value",
    "return_type",
    "return_basis",
    "corporate_action_policy",
    "currency"
  ],
  "title": "return_labels",
  "type": "object",
  "x-contract-version": "1.0",
  "x-primary-key": [
    "decision_at",
    "asset_id",
    "label"
  ],
  "x-timestamp-fields": [
    "decision_at",
    "execution_at",
    "return_start",
    "return_end"
  ]
}

    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "latency_ms": {
      "type": "number",
      "x-unit": "milliseconds"
    },
    "probe_end": {
      "format": "date-time",
      "type": "string"
    },
    "probe_start": {
      "format": "date-time",
      "type": "string"
    },
    "probe_type": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
